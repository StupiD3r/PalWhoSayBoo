shader_parameter/curve_strength = 0.9

[sub_resource type="Shader" id="Shader_pua77"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D screen_texture :
	hint_screen_texture,
	repeat_disable,
	filter_linear_mipmap;

uniform float blur_amount : hint_range(0.0, 5.0) = 3.0;

void fragment() {
	vec3 blurred_scene = textureLod(
		screen_texture,
		SCREEN_UV,
		blur_amount
	).rgb;

	COLOR = vec4(blurred_scene, 1.0);
}"

