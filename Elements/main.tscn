[sub_resource type="Shader" id="Shader_pdv6n"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform float closed_amount : hint_range(0.0, 1.0) = 1.0;
uniform float edge_softness : hint_range(0.001, 0.15) = 0.035;
uniform float curve_strength : hint_range(0.0, 1.0) = 0.9;

void fragment() {
	vec2 point = UV * 2.0 - 1.0;

	float closed = clamp(closed_amount, 0.0, 1.0);
	float opening = 1.0 - closed;

	// An opening that is wider in the middle,
	// with curved upper and lower eyelids.
	float curve = sqrt(
		max(0.0, 1.0 - curve_strength * point.x * point.x)
	);

	float opening_height = opening * 1.3 * curve;

	// Feather the boundary between the eyelid and the scene.
	float darkness = smoothstep(
		opening_height - edge_softness,
		opening_height + edge_softness,
		abs(point.y)
	);

	// Remove the remaining corners when fully opening.
	darkness *= smoothstep(0.0, 0.15, closed);

	// Completely black when fully closed.
	if (closed >= 0.999) {
		darkness = 1.0;
	}

	COLOR = vec4(0.0, 0.0, 0.0, darkness);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_pua77"]
shader = SubResource("Shader_pdv6n")
shader_parameter/closed_amount = 1.0
